# --- Logging / trazabilidad ---
# Nivel de log: DEBUG, INFO, WARNING o ERROR (default: INFO).
# DEBUG agrega detalle por request/candidato (URLs, params redactados, puntajes).
LOG_LEVEL=

# --- Job search providers ---
# Adzuna (requiere ADZUNA_APP_ID + ADZUNA_API_KEY)
ADZUNA_APP_ID=
ADZUNA_API_KEY=
# OpenWeb Ninja (JSearch)
OPEN_NINJA_API_KEY=
# Remotive: no requiere credenciales

# --- CV analyzer (LLM via OpenRouter) ---
OPENROUTER_KEY=
# Modelo usado para el análisis vía OpenRouter (default: ~deepseek/deepseek-flash-latest)
OPENROUTER_MODEL=
# Tope de tokens de salida por llamada (default: 8000)
OPENROUTER_MAX_TOKENS=
# Timeout de cada llamada al LLM en segundos (default: 60)
OPENROUTER_TIMEOUT=
# Reintentos ante errores transitorios (429/5xx) del LLM (default: 4)
OPENROUTER_RETRIES=
# Backoff base (s) entre reintentos del LLM: backoff * 2**intento (default: 1)
OPENROUTER_BACKOFF=
# Intentos máximos del análisis (parseo/JSON/reparación) (default: 3)
ANALYZER_MAX_ATTEMPTS=
# Caracteres previos del texto que entran al prompt de reparación (default: 4000)
ANALYZER_REPAIR_MAX_PREVIOUS_CHARS=
# Caracteres del error que entran al prompt de reparación (default: 4000)
ANALYZER_REPAIR_MAX_ERRORS_CHARS=
# Caracteres del contenido LLM mostrados en DEBUG si falla el parseo (default: 300)
ANALYZER_LOG_SAMPLE_CHARS=

# --- Búsqueda / scoring ---
# Umbral mínimo de match para aceptar una oferta (0..1).
# (default: 0.85; recomendado: 0.45 con scoring literal — los posts reales
# suelen puntuar hasta ~0.52)
SEARCH_MIN_MATCH=
# Peso del match de keywords en el score final (default: 0.65)
SEARCH_KEYWORD_WEIGHT=
# Peso del rango de la keyword en el score final (default: 0.35)
SEARCH_RANK_WEIGHT=
# Pesos por categoría de keyword (technical_skills, tools_and_technologies,
# ai_data_keywords, professional_skills), separados por coma (default: 1.0,0.8,1.0,0.6)
SEARCH_CATEGORY_WEIGHTS=
# Pesos por campo de la oferta (title, requirements, description), separados por coma
# (default: 1.0,1.0,1.0)
SEARCH_FIELD_WEIGHTS=
# Rango superior de las keywords por frecuencia (default: 20)
SEARCH_MAX_RANK=
# Tope de posiciones (BEST_FIT_JOB_POSITIONS) que se buscan en el mercado
SEARCH_TOP_N=
# Workers paralelos usados en la búsqueda por posición
SEARCH_MAX_WORKERS=

# Daily/hourly rate limit shared por todos los proveedores: espera entre consults
SEARCH_PROVIDER_MIN_INTERVAL=
# Timeout de GET por proveedor en segundos (default: 15)
SEARCH_PROVIDER_TIMEOUT=
# Reintentos por proveedor ante errores transitorios (default: 3)
SEARCH_PROVIDER_RETRIES=
# Backoff base (s) entre reintentos de proveedor: backoff * 2**intento (default: 1)
SEARCH_PROVIDER_BACKOFF=
# Resultados por página en Adzuna (default: 20)
ADZUNA_RESULTS_PER_PAGE=
# Espera mínima entre consultas a Adzuna en segundos (default: 0.5)
ADZUNA_MIN_INTERVAL=
# Páginas consultadas en OpenWeb Ninja JSearch (default: 1)
OPEN_NINJA_NUM_PAGES=

# --- Pipeline / API ---
# Tamaño máximo permitido para el archivo del CV en bytes (default: 5242880 = 5 MB)
MAX_CV_BYTES=
# Límite de caracteres del texto del CV enviado al LLM (default: 60000)
MAX_RESUME_CHARS=
# Directorio donde se guardan los reportes PDF generados (default: reports)
OUTPUT_DIR=

# GENAI_API_KEY=  # reservado para Gemini (aún no implementado)