<div class="job-market-page">
  <h2 class="page-title">Job Market Analysis</h2>

  <table class="report-table summary-stats">
    <thead>
      <tr>
        <th>Jobs Found</th>
        <th>Matches</th>
        <th>Providers Queried</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>{{ summary.total_jobs_found }}</td>
        <td>{{ summary.total_matched_jobs }}</td>
        <td>{{ summary.attempted_providers|join(", ") or "none" }}</td>
      </tr>
    </tbody>
  </table>

  {% if summary.had_errors %}
    <p class="meta">Note: some providers reported errors during the search.</p>
  {% endif %}

  <table class="report-table">
    <thead>
      <tr>
        <th>Job Title</th>
        <th>Company</th>
        <th>Location</th>
        <th>Source</th>
        <th>Apply Link</th>
      </tr>
    </thead>
    <tbody>
    {% for r in rows %}
      <tr>
        <td>{{ r.title }}</td>
        <td>{{ r.company }}</td>
        <td>{{ r.location }}</td>
        <td>{{ r.source_provider or "—" }}</td>
        <td>{% if r.apply_url %}<a href="{{ r.apply_url }}">Apply Link</a>{% else %}—{% endif %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</div>