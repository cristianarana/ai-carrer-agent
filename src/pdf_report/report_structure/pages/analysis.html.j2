<div class="analysis-page">
  <h2 class="page-title">Resume Analysis</h2>

  <section>
    <h3 class="section-title">Best-fit job positions for your profile</h3>
    <table class="report-table">
      <thead>
        <tr><th style="width:6%">Rank</th><th style="width:24%">Position</th><th>Match Explanation</th></tr>
      </thead>
      <tbody>
      {% for p in best_fit %}
        <tr>
          <td>{{ p.rank }}</td>
          <td>{{ p.position }}</td>
          <td>{{ p.match_explanation }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  <section>
    <h3 class="section-title">Keywords for ATS Optimization</h3>
    <table class="report-table">
      <thead>
        <tr>
          <th>Technical Skills</th>
          <th>Tools &amp; Technologies</th>
          <th>Professional Skills</th>
          <th>AI &amp; Data</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><ul>{% for k in ats.technical_skills %}<li>{{ k }}</li>{% endfor %}</ul></td>
          <td><ul>{% for k in ats.tools_and_technologies %}<li>{{ k }}</li>{% endfor %}</ul></td>
          <td><ul>{% for k in ats.professional_skills %}<li>{{ k }}</li>{% endfor %}</ul></td>
          <td><ul>{% for k in ats.ai_data_keywords %}<li>{{ k }}</li>{% endfor %}</ul></td>
        </tr>
      </tbody>
    </table>
  </section>

  <section>
    <h3 class="section-title">10-Second Recruiter Test</h3>
    <table class="report-table">
      <tbody>
        <tr>
          <th style="width:30%">Positive</th>
          <td><ul>{% for item in recruiter.positive %}<li>{{ item }}</li>{% endfor %}</ul></td>
        </tr>
        <tr>
          <th>Unclear or Weak</th>
          <td><ul>{% for item in recruiter.unclear_or_weak %}<li>{{ item }}</li>{% endfor %}</ul></td>
        </tr>
        <tr>
          <th>Could Cause Rejection</th>
          <td><ul>{% for item in recruiter.could_cause_rejection %}<li>{{ item }}</li>{% endfor %}</ul></td>
        </tr>
      </tbody>
    </table>
  </section>

  <section>
    <h3 class="section-title">Resume Score</h3>
    <p class="score-value">{{ score.overall_score }}/10</p>
    <p>{{ score.explanation }}</p>
    <table class="report-table">
      <tbody>
      {% for label, value in score_breakdown %}
        <tr class="score-bar-row">
          <td class="score-bar-label">{{ label }}</td>
          <td>
            <span class="score-bar-track"><span class="score-bar-fill" style="width: {{ value * 10 }}%"></span></span>
            <span>{{ value }}/10</span>
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  <section>
    <h3 class="section-title">How to Reach Excellence (10/10)</h3>
    {% for items, label in improvements %}
      <h4 class="sub-section-title">{{ label }}</h4>
      <ul>
      {% for item in items %}
        <li>
          <span class="badge badge-{{ item.priority|lower }}">{{ item.priority }}</span>
          {{ item.impact }}
        </li>
      {% endfor %}
      </ul>
    {% endfor %}
  </section>
</div>